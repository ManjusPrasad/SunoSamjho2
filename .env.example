# ==============================================================================
# SunoSamjho Live - Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gnani AI Credentials (Server-side only; never expose these as VITE_* variables)
# Put a newly rotated credential here (X-API-Key-ID for Prisma/Timbre).
# Keep this file blank of real credentials and keep the actual .env untracked.
# ------------------------------------------------------------------------------
GNANI_API_KEY=
GNANI_API_KEY_ID=
GNANI_API_KEY_SECRET=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_WS_URL=
GNANI_TIMBRE_BASE_URL=https://api.vachana.ai
# Evon v3.3 is distributed as gated open weights; set this only after access approval
# and after hosting it behind an OpenAI-compatible chat-completions endpoint.
GNANI_EVON_BASE_URL=
GNANI_EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
GNANI_EVON_API_KEY=

# ------------------------------------------------------------------------------
# Mock Provider Switch (Development and Testing only)
# Set to 'true' to run with a simulated provider if you do not yet have Gnani credentials.
# STRICT SAFETY GUARD: Will throw an error if enabled when NODE_ENV=production.
# ------------------------------------------------------------------------------
ENABLE_MOCK_PROVIDER=true

# ------------------------------------------------------------------------------
# Server Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Comma-separated allowed browser origins when testing multiple local/LAN clients.
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase Configuration
# Server requires service role key for admin tasks & API key lookups.
# Client requires anon key and URL.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Firebase email/password authentication (client configuration)
# Enable Email/Password in Firebase Authentication and add localhost to
# Authentication -> Settings -> Authorized domains.
# Add your production app domain before deploying.
# Firebase web config values are public client settings; never put admin credentials here.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=studio-8773521461-fa390
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_LINK_DOMAIN=

# ------------------------------------------------------------------------------
# Client API Connection
# Set these to the public backend HTTP and WebSocket origins when deploying
# the web app and API as separate services. Leave on localhost for development.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_BASE_URL=ws://localhost:4000
SUNOSAMJHO_API_BASE_URL=http://localhost:4000
